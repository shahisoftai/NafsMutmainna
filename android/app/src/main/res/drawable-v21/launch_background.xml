<?xml version="1.0" encoding="utf-8"?>
<!-- HeartOS native launch splash (API 21+): brand color background with centered logo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/heartos_brand" />

    <item android:gravity="center">
        <bitmap
            android:gravity="center"
            android:src="@drawable/heartos_logo" />
    </item>
</layer-list>
