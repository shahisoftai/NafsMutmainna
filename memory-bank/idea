Database Schema (PostgreSQL)
SQL-- Enable UUID extension
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

-- ========================================
-- 1. PROFILES (Extended User Data)
-- ========================================
CREATE TABLE profiles (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    user_id UUID REFERENCES auth.users(id) ON DELETE CASCADE NOT NULL UNIQUE,
    
    full_name TEXT,
    username TEXT UNIQUE,
    avatar_url TEXT,
    bio TEXT,
    
    -- Spiritual Journey
    nafs_stage TEXT DEFAULT 'ammarah' CHECK (nafs_stage IN ('ammarah', 'lawwamah', 'mutmainna')),
    joined_at TIMESTAMPTZ DEFAULT NOW(),
    
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- ========================================
-- 2. NAFS ATTRIBUTES (Master Table)
-- ========================================
CREATE TABLE nafs_attributes (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    name TEXT NOT NULL,                    -- e.g., "Anger", "Tawakkul", "Envy"
    category TEXT NOT NULL,                -- 'negative' or 'positive'
    description TEXT,
    opposite_to TEXT,                      -- For negative traits: opposite positive trait
    quran_ref TEXT[],                      -- Array of references
    hadith_ref TEXT[],
    
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- ========================================
-- 3. DAILY CHECK-INS
-- ========================================
CREATE TABLE daily_checkins (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    user_id UUID REFERENCES auth.users(id) ON DELETE CASCADE NOT NULL,
    
    checkin_date DATE NOT NULL DEFAULT CURRENT_DATE,
    overall_mood INTEGER CHECK (overall_mood BETWEEN 1 AND 10),  -- 1-10 peace level
    nafs_stage_today TEXT CHECK (nafs_stage_today IN ('ammarah', 'lawwamah', 'mutmainna')),
    
    notes TEXT,
    
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW(),
    
    UNIQUE(user_id, checkin_date)
);

-- ========================================
-- 4. EMOTION / TRIGGER LOGS
-- ========================================
CREATE TABLE emotion_logs (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    user_id UUID REFERENCES auth.users(id) ON DELETE CASCADE NOT NULL,
    
    emotion TEXT NOT NULL,                 -- e.g., "Anger", "Jealousy", "Restlessness"
    intensity INTEGER CHECK (intensity BETWEEN 1 AND 10),
    trigger TEXT,
    situation TEXT,
    
    related_attribute_id UUID REFERENCES nafs_attributes(id),
    nafs_response TEXT,                    -- How user reacted (impulsive, controlled, etc.)
    
    reflection TEXT,                       -- User's own reflection
    action_taken TEXT,                     -- Dua, dhikr, etc.
    
    logged_at TIMESTAMPTZ DEFAULT NOW()
);

-- ========================================
-- 5. JOURNAL ENTRIES (Muhasabah)
-- ========================================
CREATE TABLE journal_entries (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    user_id UUID REFERENCES auth.users(id) ON DELETE CASCADE NOT NULL,
    
    entry_date DATE NOT NULL DEFAULT CURRENT_DATE,
    title TEXT,
    content TEXT NOT NULL,
    
    tags TEXT[],                           -- e.g., {"gratitude", "tawbah", "patience"}
    mood INTEGER CHECK (mood BETWEEN 1 AND 10),
    
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- ========================================
-- 6. HABITS & GOALS
-- ========================================
CREATE TABLE user_habits (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    user_id UUID REFERENCES auth.users(id) ON DELETE CASCADE NOT NULL,
    
    name TEXT NOT NULL,                    -- e.g., "Morning Adhkar", "Night Muhasabah"
    description TEXT,
    frequency TEXT DEFAULT 'daily',        -- daily, weekly
    
    target_streak INTEGER DEFAULT 21,
    is_active BOOLEAN DEFAULT true,
    
    created_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE habit_logs (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    habit_id UUID REFERENCES user_habits(id) ON DELETE CASCADE NOT NULL,
    user_id UUID REFERENCES auth.users(id) ON DELETE CASCADE NOT NULL,
    
    completed_date DATE NOT NULL DEFAULT CURRENT_DATE,
    completed_at TIMESTAMPTZ DEFAULT NOW(),
    
    UNIQUE(habit_id, completed_date)
);

-- ========================================
-- Indexes for Performance
-- ========================================
CREATE INDEX idx_profiles_user_id ON profiles(user_id);
CREATE INDEX idx_daily_checkins_user_date ON daily_checkins(user_id, checkin_date);
CREATE INDEX idx_emotion_logs_user ON emotion_logs(user_id);
CREATE INDEX idx_journal_entries_user_date ON journal_entries(user_id, entry_date);
CREATE INDEX idx_habit_logs_user ON habit_logs(user_id);

