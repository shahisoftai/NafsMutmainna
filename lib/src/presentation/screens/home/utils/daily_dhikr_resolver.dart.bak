/// Source of the dhikr shown in the "Today's Practice" hero card.
enum DhikrSource {
  /// Derived from today's most recent check-in emotion.
  todayCheckin,

  /// Curated fallback based on the user's dominant Nafs state.
  nafsStateBased,
}

